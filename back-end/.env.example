# ============================================================
# AI 配置模板文件 — 复制为 .env 后填入真实密钥
# .env 文件已被 .gitignore 排除，不会提交到 Git
# ============================================================

# Chat 模型提供商: deepseek | openai | qwen | ollama
AI_PROVIDER=deepseek

# DeepSeek（推荐）: https://platform.deepseek.com 注册获取
OPENAI_API_KEY=sk-替换为你的真实密钥
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-chat

# Embedding 提供商: none | ollama | openai
# none = 禁用 RAG（AI优化和Agent仍可用）
# ollama = 本地 Embedding（免费，需 ollama pull nomic-embed-text）
EMBEDDING_PROVIDER=none
